define = -DPOSRES
nsteps = 50000
nstxout-compressed = 5000
nstenergy = 1000
nstlog = 1000
continuation = yes
gen_vel = no
refcoord_scaling = com
pcoupl = C-rescale
pcoupltype = isotropic
tau_p = 2.0
ref_p = 1.0
compressibility = 4.5e-5
integrator = md
dt = 0.002
constraint_algorithm = lincs
constraints = h-bonds
lincs_iter = 1
lincs_order = 4
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau_t = 0.1 0.1
ref_t = 310 310
comm-mode = Linear
nstcomm = 100
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
DispCorr = EnerPres
pbc = xyz
